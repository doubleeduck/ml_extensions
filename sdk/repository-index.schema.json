{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mangalaunch.invalid/schemas/repository-index-v1.json",
  "title": "MangaLaunch signed source repository index v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "repositoryId", "serial", "generatedAt", "expiresAt", "publisherKeyId", "channel", "packages"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repositoryId": {"type": "string", "maxLength": 140, "pattern": "^[a-z0-9-]+/[a-z0-9_.-]+$"},
    "serial": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "generatedAt": {"$ref": "#/$defs/timestamp"}, "expiresAt": {"$ref": "#/$defs/timestamp"},
    "publisherKeyId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "channel": {"enum": ["stable", "prerelease"]},
    "packages": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/package"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "string", "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["extensionId", "version", "releaseTag", "assetName", "size", "sha256", "sourceApiVersion", "minRuntimeAbi", "minAppVersion", "sourceIds", "channel"],
      "properties": {
        "extensionId": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"},
        "releaseTag": {"type": "string", "minLength": 1, "maxLength": 256},
        "assetName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}\\.mlsource$"},
        "size": {"type": "integer", "minimum": 22, "maximum": 8388608},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sourceApiVersion": {"const": 1}, "minRuntimeAbi": {"const": 1},
        "minAppVersion": {"$ref": "#/$defs/version"},
        "sourceIds": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "channel": {"enum": ["stable", "prerelease"]}
      }
    }
  }
}
